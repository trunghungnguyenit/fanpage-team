# Cổng server API
PORT=5000
# Origin của frontend được phép gọi API từ trình duyệt
CORS_ORIGIN=http://localhost:3000

# Supabase: lấy ở Project Settings > API.
# Service role key chỉ dùng ở backend, KHÔNG đưa vào frontend và KHÔNG commit.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Địa chỉ backend API (frontend gọi từ phía server)
API_URL=http://localhost:5000
SITE_URL=http://localhost:3000

# Trang quản trị /admin chạy ở trình duyệt nên cần biến NEXT_PUBLIC_*
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Anon key (Project Settings > API), an toàn để công khai. KHÔNG dùng service role key ở đây.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
